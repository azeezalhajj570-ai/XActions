generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String?         @unique
  username            String          @unique
  password            String?
  credits             Int             @default(0)
  isGuest             Boolean         @default(false)
  emailVerified       Boolean         @default(false)
  isAdmin             Boolean         @default(false)
  followBonusClaimed  Boolean         @default(false)
  twitterId           String?         @unique
  twitterUsername     String?
  twitterAccessToken  String?
  twitterRefreshToken String?
  twitterTokenExpiry  DateTime?
  sessionCookie       String?
  authMethod          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  cryptoPayments      CryptoPayment[]
  operations          Operation[]
  payments            Payment[]
  subscription        Subscription?
  accounts            Account[]
  groups              Group[]

  @@index([email])
  @@index([username])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tier                 String
  status               String
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  startDate            DateTime
  endDate              DateTime?
  cancelAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

model Operation {
  id              String    @id @default(cuid())
  userId          String
  type            String
  status          String
  config          String?
  result          String?
  unfollowedCount Int?      @default(0)
  followedCount   Int?      @default(0)
  creditsUsed     Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  type            String
  amount          Float
  currency        String   @default("usd")
  stripePaymentId String?  @unique
  stripeInvoiceId String?
  status          String
  creditsAdded    Int?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model JobQueue {
  id          String    @id @default(cuid())
  type        String
  data        String
  status      String
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  processedAt DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority])
  @@index([createdAt])
}

model CryptoPayment {
  id          String    @id @default(cuid())
  paymentId   String    @unique
  userId      String?
  email       String?
  package     String
  credits     Int
  amountUSD   Float
  currency    String
  amount      Float
  status      String    @default("pending")
  txHash      String?
  provider    String?
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@index([email])
}

model License {
  id              String    @id @default(cuid())
  key             String    @unique
  tier            String
  customerName    String?
  customerEmail   String?
  companyName     String?
  maxUsers        Int       @default(500)
  maxInstances    Int       @default(1)
  whiteLabel      Boolean   @default(false)
  customDomain    Boolean   @default(false)
  apiAccess       Boolean   @default(false)
  activations     Int       @default(0)
  lastActivatedAt DateTime?
  instanceIds     String?
  status          String    @default("active")
  expiresAt       DateTime?
  paymentId       String?
  amountPaid      Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([key])
  @@index([customerEmail])
  @@index([status])
}

model AccountSnapshot {
  id        String   @id @default(cuid())
  username  String
  type      String   @default("full")
  data      String
  createdAt DateTime @default(now())

  @@index([username, type])
  @@index([createdAt])
}

model FollowerSnapshot {
  id         String   @id @default(cuid())
  userId     String
  username   String
  followers  String
  totalCount Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([username, createdAt])
}

model FollowerChange {
  id            String    @id @default(cuid())
  userId        String
  type          String
  username      String
  name          String?
  avatarUrl     String?
  detectedAt    DateTime  @default(now())
  followedSince DateTime?

  @@index([userId, detectedAt])
  @@index([userId, type])
}

model UnfollowerSchedule {
  id         String    @id @default(cuid())
  userId     String    @unique
  interval   String
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  webhookUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, nextRunAt])
}

// ---------------------------------------------------------------------------
// Group Automation (feature/group-automation)
// ---------------------------------------------------------------------------

model Account {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String
  displayName   String?
  profileUrl    String?
  avatar        String?
  sessionCookie String?
  authMethod    String        @default("session")
  isActive      Boolean       @default(true)
  isBlocked     Boolean       @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  groups        GroupAccount[]
  tasks         GroupTask[]

  @@unique([userId, username])
  @@index([userId])
  @@index([isActive])
}

model Group {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  actions     String         @default("{\"like\":true,\"comment\":false,\"repost\":false,\"follow\":false}")
  autoExecute Boolean        @default(false)
  cooldownSec Int            @default(0)
  paused      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  accounts    GroupAccount[]
  members     GroupMember[]
  tasks       GroupTask[]

  @@index([userId])
}

model GroupAccount {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, accountId])
  @@index([accountId])
}

model GroupMember {
  id          String     @id @default(cuid())
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  username    String
  displayName String?
  profileUrl  String?
  avatar      String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  tasks       GroupTask[]

  @@unique([groupId, username])
  @@index([username])
}

model GroupTask {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  memberId    String
  member      GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action      String
  targetId    String?
  status      String       @default("PENDING")
  priority    Int          @default(5)
  claimedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  retryCount  Int          @default(0)
  nextRetryAt DateTime?
  error       String?
  result      String?
  createdAt   DateTime     @default(now())

  @@unique([groupId, accountId, memberId, action])
  @@index([groupId, status])
  @@index([accountId, status])
  @@index([status, nextRetryAt])
}

model XGroupMember {
  id              String   @id @default(cuid())
  conversationId  String
  xUserId         String
  username        String
  displayName     String?
  profileUrl      String?
  avatarUrl       String?
  isAdmin         Boolean  @default(false)
  isCurrentMember Boolean  @default(true)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([conversationId, xUserId])
  @@index([conversationId])
  @@index([username])
}
